.container { padding: 16rpx 24rpx; min-height: 100vh; }

/* Period Selector */
.period-bar { display: flex; gap: 16rpx; padding: 16rpx 0; justify-content: center; }
.period-tag {
  padding: 10rpx 32rpx; border-radius: 40rpx; font-size: 26rpx;
  background: var(--surface); color: var(--text2);
}
.period-tag.active { background: var(--green); color: #fff; font-weight: bold; }

.loading-box { text-align: center; padding: 120rpx 0; }
.loading-text { color: var(--text3); font-size: 28rpx; }

.section-title { font-size: 30rpx; font-weight: bold; color: var(--text); margin: 24rpx 0 12rpx; }

/* Chart Card */
.chart-card {
  background: var(--surface); border-radius: 16rpx; padding: 12rpx 4rpx;
  margin-bottom: 8rpx;
}

/* Stats Grid */
.stats-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.stat-card {
  width: calc(50% - 8rpx); background: var(--surface); border-radius: 20rpx;
  padding: 20rpx; text-align: center; box-sizing: border-box;
  box-shadow: var(--card-shadow); border: 1rpx solid var(--border-light);
}
.stat-icon { font-size: 32rpx; display: block; margin-bottom: 6rpx; }
.stat-val { font-size: 44rpx; font-weight: bold; color: var(--text); display: block; }
.stat-label { font-size: 22rpx; color: var(--text2); margin-top: 4rpx; display: block; }

/* Achievements */
.achieve-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.achieve-badge {
  padding: 10rpx 20rpx; background: var(--green-dim); color: var(--green);
  border-radius: 20rpx; font-size: 24rpx;
}

/* Exercise Types */
.ex-list { display: flex; flex-direction: column; gap: 12rpx; }
.ex-row { display: flex; align-items: center; gap: 12rpx; }
.ex-name { width: 120rpx; font-size: 26rpx; color: var(--text); }
.ex-count { width: 60rpx; font-size: 24rpx; color: var(--text2); text-align: right; }
.ex-bar { flex: 1; height: 8rpx; background: var(--border); border-radius: 4rpx; overflow: hidden; }
.ex-bar-fill { height: 8rpx; background: var(--green); border-radius: 4rpx; transition: width 0.5s; }

/* Empty State */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; color: var(--text3); }
.empty-icon { font-size: 56rpx; margin-bottom: 8rpx; }
.empty-text { font-size: 26rpx; }

/* Videos */
.video-list { display: flex; flex-direction: column; gap: 16rpx; }
.video-card { display: flex; gap: 16rpx; background: var(--surface); border-radius: 12rpx; overflow: hidden; }
.video-pic { width: 160rpx; height: 100rpx; }
.video-info { flex: 1; padding: 12rpx 0; display: flex; flex-direction: column; justify-content: center; }
.video-title { font-size: 26rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.video-author { font-size: 22rpx; color: var(--text3); margin-top: 4rpx; }

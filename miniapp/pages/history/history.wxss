.container { padding: 16rpx 24rpx; min-height: 100vh; }

.subnav-bar { display: flex; gap: 12rpx; padding: 16rpx 0; }
.subnav-tag {
  padding: 12rpx 28rpx; border-radius: 24rpx; font-size: 26rpx;
  background: var(--surface); color: var(--text2); border: 1px solid var(--border);
}
.subnav-tag.active { background: var(--green-dim); color: var(--green); border-color: var(--green); }

.loading-box { text-align: center; padding: 120rpx 0; }
.loading-text { color: var(--text3); font-size: 28rpx; }

.record-list { display: flex; flex-direction: column; gap: 12rpx; }
.record-card {
  background: var(--surface); border-radius: 14rpx; padding: 20rpx 22rpx;
}
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.record-date { font-size: 26rpx; color: var(--text); font-weight: bold; }
.record-type { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 12rpx; }
.record-type.badge-green { background: var(--green-dim); color: var(--green); }
.record-type.badge-orange { background: var(--orange-dim); color: var(--orange); }
.record-body { display: flex; flex-wrap: wrap; gap: 10rpx; }
.record-detail { font-size: 24rpx; color: var(--text2); background: var(--bg3); padding: 4rpx 12rpx; border-radius: 6rpx; }
.record-notes { font-size: 24rpx; color: var(--text3); margin-top: 8rpx; display: block; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; color: var(--text3); }
.empty-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.empty-text { font-size: 26rpx; }

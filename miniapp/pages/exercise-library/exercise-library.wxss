.container { padding: 16rpx 24rpx; min-height: 100vh; }

.page-header { padding: 8rpx 0 12rpx; }
.page-header .title { font-size: 40rpx; font-weight: bold; color: var(--green); display: block; }
.subtitle { font-size: 26rpx; color: var(--text3); margin-top: 4rpx; display: block; }

/* Search */
.search-bar { margin-bottom: 12rpx; }
.search-input {
  width: 100%; padding: 16rpx 24rpx; background: var(--surface);
  border: 1px solid var(--border); border-radius: 12rpx;
  color: var(--text); font-size: 28rpx; box-sizing: border-box;
}

/* Filter Chips */
.filter-row { display: flex; gap: 10rpx; padding: 8rpx 0; white-space: nowrap; margin-bottom: 4rpx; }
.filter-chip {
  display: inline-block; padding: 10rpx 22rpx; border-radius: 24rpx;
  font-size: 24rpx; background: var(--surface); color: var(--text2);
  border: 1px solid var(--border); flex-shrink: 0;
}
.filter-chip.active { background: var(--green-dim); color: var(--green); border-color: var(--green); }

.result-count { font-size: 24rpx; color: var(--text3); padding: 12rpx 0; display: block; }

/* Exercise Grid */
.ex-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ex-card {
  width: calc(50% - 8rpx); background: var(--surface); border-radius: 16rpx;
  overflow: hidden; box-sizing: border-box; transition: all 0.2s;
}
.ex-card:active { opacity: 0.85; transform: scale(0.97); }

/* Image */
.ex-img-wrap { width: 100%; height: 220rpx; background: var(--bg2); overflow: hidden; }
.ex-img { width: 100%; height: 100%; }
.ex-img-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--bg2), rgba(74,222,128,0.05));
}
.ex-ph-icon { font-size: 56rpx; }

.ex-card-name {
  font-size: 28rpx; color: var(--text); font-weight: bold;
  display: block; padding: 14rpx 16rpx 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ex-card-tags { display: flex; flex-wrap: wrap; gap: 6rpx; padding: 0 16rpx 8rpx; }
.ex-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; }
.ex-tag.badge-green { background: var(--green-dim); color: var(--green); }
.ex-tag.badge-blue { background: var(--blue-dim); color: var(--blue); }
.ex-difficulty { font-size: 20rpx; padding: 0 16rpx 14rpx; display: flex; gap: 2rpx; }

/* Empty / Load */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; color: var(--text3); }
.empty-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.empty-text { font-size: 26rpx; }
.load-more, .load-end { text-align: center; padding: 32rpx 0; }
.load-more { color: var(--green); font-size: 28rpx; }
.load-end { color: var(--text3); font-size: 24rpx; }

/* ═══ Detail Popup ═══ */
.detail-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.85); z-index: 1000;
  display: flex; align-items: flex-end; justify-content: center;
}
.detail-sheet {
  width: 100%; max-height: 85vh; background: var(--surface);
  border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto; position: relative;
}
.ds-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center;
}
.ds-close text { font-size: 28rpx; color: var(--text2); }

.ds-img-wrap { width: 100%; height: 400rpx; background: var(--bg2); border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.ds-img { width: 100%; height: 100%; }
.ds-img-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--bg2), rgba(74,222,128,0.06));
}
.ds-ph-icon { font-size: 96rpx; }

.ds-name { font-size: 36rpx; font-weight: 700; color: var(--text); display: block; margin-bottom: 4rpx; }
.ds-name-en { font-size: 24rpx; color: var(--text3); display: block; margin-bottom: 20rpx; }

.ds-meta { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 28rpx; }
.ds-meta-tag {
  padding: 8rpx 18rpx; border-radius: 12rpx; font-size: 24rpx;
  background: var(--bg2); color: var(--text2);
}

.ds-instructions { border-top: 1px solid var(--border); padding-top: 24rpx; }
.ds-inst-label { font-size: 26rpx; font-weight: 600; color: var(--green); display: block; margin-bottom: 12rpx; }
.ds-inst-text { font-size: 26rpx; color: var(--text2); line-height: 1.8; display: block; }

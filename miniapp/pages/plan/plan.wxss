.container { padding: 16rpx 24rpx; min-height: 100vh; }
.page-header { padding: 8rpx 0 16rpx; display: flex; justify-content: space-between; align-items: center; }
.page-header .title { font-size: 40rpx; font-weight: bold; color: var(--green); }
.header-action { padding: 8rpx 0; }
.ha-link { font-size: 26rpx; color: var(--green); text-decoration: underline; }

/* Empty CTA */
.empty-cta {
  margin-top: 32rpx; background: var(--green); color: #fff;
  border-radius: 24rpx; font-size: 28rpx; font-weight: 600;
  padding: 18rpx 48rpx; border: none;
}

.section-title { font-size: 30rpx; font-weight: bold; color: var(--text); margin: 24rpx 0 12rpx; }

/* Plan Header */
.plan-header { text-align: center; }
.plan-meta { display: flex; justify-content: center; gap: 24rpx; margin-bottom: 20rpx; }
.plan-goal { font-size: 28rpx; color: var(--text); font-weight: bold; }
.plan-freq { font-size: 26rpx; color: var(--text2); }
.plan-stats { display: flex; justify-content: center; gap: 48rpx; }
.plan-stat-item { text-align: center; }
.plan-stat-val { font-size: 36rpx; font-weight: bold; display: block; }
.plan-stat-lbl { font-size: 22rpx; color: var(--text2); margin-top: 2rpx; }

/* Week tabs */
.week-scroll { margin-bottom: 8rpx; }
.week-tabs { display: flex; gap: 12rpx; white-space: nowrap; padding: 8rpx 0; }
.week-tab {
  padding: 12rpx 28rpx; border-radius: 24rpx; font-size: 26rpx;
  background: var(--surface); color: var(--text2); border: 1rpx solid var(--border);
}
.week-tab.active { background: var(--green); color: #fff; border-color: var(--green); }

/* Progress bar */
.plan-progress-bar {
  margin-top: 20rpx; height: 6rpx; background: var(--bg3); border-radius: 3rpx; overflow: hidden;
}
.ppb-fill { height: 100%; background: var(--green); border-radius: 3rpx; transition: width 0.5s; }

/* Status bar */
.status-bar { display: flex; align-items: center; justify-content: space-around;
  background: var(--surface); border-radius: 16rpx; padding: 20rpx 16rpx; margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
}
.sb-item { text-align: center; flex: 1; }
.sb-val { font-size: 28rpx; font-weight: 700; color: var(--text); display: block; }
.sb-lbl { font-size: 20rpx; color: var(--text3); margin-top: 2rpx; display: block; }
.sb-divider { width: 1rpx; height: 40rpx; background: var(--border); }

/* Insight card */
.insight-card { padding: 24rpx; margin-top: 32rpx; margin-bottom: 32rpx; border: 1rpx solid rgba(74,222,128,0.15); }
.ic-title { font-size: 26rpx; font-weight: 600; color: var(--green); display: block; margin-bottom: 12rpx; }
.ic-text { font-size: 24rpx; color: var(--text2); line-height: 1.7; display: block; }
.ic-future { font-size: 24rpx; color: var(--text3); line-height: 1.6; display: block; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); }

/* Day Card */
.day-card { padding: 20rpx 24rpx; }
.day-head { display: flex; justify-content: space-between; align-items: center; }
.day-head:active { opacity: 0.7; }
.day-left { display: flex; flex-direction: column; gap: 2rpx; flex: 1; }
.day-name { font-size: 32rpx; font-weight: bold; color: var(--text); }
.day-focus-text { font-size: 24rpx; color: var(--text3); margin-top: 2rpx; }
.day-right { display: flex; align-items: center; gap: 12rpx; }
.day-badge {
  padding: 6rpx 18rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: bold;
}
.day-badge.rest { background: var(--bg3); color: var(--text3); }
.day-badge.done { background: var(--green-dim); color: var(--green); }
.day-badge.pending { background: var(--orange-dim); color: var(--orange); }

/* Expand arrow */
.expand-arrow {
  font-size: 24rpx; color: var(--text3); transition: transform 0.2s;
}
.expand-arrow.open { transform: rotate(180deg); }

/* Day Body */
.day-body {
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.ex-section { margin-bottom: 14rpx; }
.ex-section-title { font-size: 24rpx; color: var(--text2); margin-bottom: 8rpx; font-weight: bold; }
.ex-row { display: flex; justify-content: space-between; align-items: flex-start;
  padding: 12rpx 14rpx; background: var(--bg2); border-radius: 10rpx; margin-bottom: 6rpx; }
.ex-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.ex-name { font-size: 26rpx; color: var(--text); }
.ex-why { font-size: 22rpx; color: var(--text3); line-height: 1.4; }
.ex-detail { font-size: 22rpx; color: var(--green); background: var(--green-dim); padding: 2rpx 12rpx; border-radius: 8rpx; white-space: nowrap; margin-left: 12rpx; }

.day-rest { padding: 20rpx 16rpx; text-align: center; font-size: 26rpx; color: var(--text2); }
.day-tip { font-size: 22rpx; color: var(--text3); border-top: 1rpx solid var(--border); padding-top: 12rpx; margin-top: 10rpx; }

.day-action { padding-top: 12rpx; }
.complete-btn {
  background: var(--green); color: #fff; border-radius: 24rpx;
  font-size: 26rpx; font-weight: bold; padding: 16rpx 0;
}

# FitAI Web Configuration
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
FITAI_HOST=127.0.0.1
FITAI_PORT=8000
REMOTE_SETUP_SECRET_TTL_MINUTES=30
CORS_ORIGINS=*
# 硅基流动 — 视觉模型，用于拍照食物识别 (注册地址: https://siliconflow.cn)
LLM_VISION_PROVIDER=openai
LLM_VISION_API_KEY=sk-your-key
LLM_VISION_BASE_URL=https://api.siliconflow.cn/v1
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# CalorieNinjas — 免费食物识别 API 备用
CALORIENINJAS_API_KEY=

# 微信小程序 (注册地址: https://mp.weixin.qq.com)
WECHAT_APPID=wx_your_appid_here
WECHAT_SECRET=your_secret_here

# 字段级加密主密钥（32 字节 base64）。生成: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_SECRET_KEY=

# MiniMax Speech — demo 视频配音（注册 https://platform.minimaxi.com）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 若 404 可换 https://api.minimaxi.chat
# MINIMAX_BASE_URL=https://api.minimax.chat
# 可选英音：English_CaptivatingStoryteller / English_Trustworth_Man / English_Steadymentor
# MINIMAX_VOICE_ID=English_CaptivatingStoryteller
